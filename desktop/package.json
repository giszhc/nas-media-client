{
  "name": "yunying-desktop",
  "version": "1.0.0",
  "private": true,
  "description": "云影 · NAS 媒体中心 桌面客户端",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist:mac": "electron-builder --mac --arm64 --dir -c.asar=false && npm run sign:mac",
    "sign:mac": "xattr -cr \"dist/mac-arm64/云影.app\" && codesign --force --deep --sign - \"dist/mac-arm64/云影.app\" && codesign --verify --deep --strict \"dist/mac-arm64/云影.app\" && echo \"ad-hoc 签名完成\"",
    "dist:win": "electron-builder --win --x64",
    "dist:all": "electron-builder --mac --win"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.yunying.nasmedia",
    "productName": "云影",
    "asar": false,
    "files": [
      "main.js",
      "!node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": "../server.js",
        "to": "app/server.js"
      },
      {
        "from": "../lib",
        "to": "app/lib"
      },
      {
        "from": "../public",
        "to": "app/public"
      }
    ],
    "mac": {
      "category": "public.app-category.entertainment",
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "build/icon.icns"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "云影"
    }
  }
}
